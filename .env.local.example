# Local profile template. Copy to the ignored .env.local and fill values.
# Uses Docker PostgreSQL (real storage) and the Firestore emulator. Teammate
# services that are not running locally must be replaced only through the
# explicit dev-local/ launcher; normal entrypoints fail when they are missing.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Disposable database on the Compose PostgreSQL container. Do not point at the
# original hospital_allocation database. Use your own local password.
DATABASE_URL=postgresql+psycopg2://postgres:<local-password>@localhost:5432/hospital_allocation_local_test
TEST_POSTGRES_URL=postgresql+psycopg2://postgres:<local-password>@localhost:5432/hospital_allocation_pratham_test

FIRESTORE_PROJECT_ID=hospital-bed-mgmt-dev
FIRESTORE_EMULATOR_HOST=localhost:8080

# Real teammate endpoints if available locally; otherwise leave empty and use dev-local/.
LOCK_SERVICE_ADDR=
LOCK_COORDINATOR_ADDR=
BED_SERVICE_ADDR=
STAFF_SERVICE_ADDR=
TRIAGE_SERVICE_ADDR=localhost:50052
PATIENT_SERVICE_URL=

RPC_TIMEOUT_MS=2000
LOCK_WAIT_TIMEOUT_MS=5000
LOCK_LEASE_MS=10000

ENABLE_RECOVERY_WORKER=true
ENABLE_OUTBOX_WORKER=false
