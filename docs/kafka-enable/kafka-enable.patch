diff -ruN --strip-trailing-cr a/k8s/resource-analytics/overlays/gke/secret-provider-class.yaml b/k8s/resource-analytics/overlays/gke/secret-provider-class.yaml
--- a/k8s/resource-analytics/overlays/gke/secret-provider-class.yaml	1970-01-01 05:30:00.000000000 +0530
+++ b/k8s/resource-analytics/overlays/gke/secret-provider-class.yaml	2026-11-15 19:12:22.733219600 +0530
@@ -0,0 +1,13 @@
+# Resource Analytics' own Kafka credentials (DeveloperRead on bed-stats, group resource-analytics-*).
+apiVersion: secrets-store.csi.x-k8s.io/v1
+kind: SecretProviderClass
+metadata:
+  name: resource-analytics-secrets
+spec:
+  provider: gke
+  parameters:
+    secrets: |
+      - resourceName: "projects/hospital-management-514618/secrets/kafka-analytics-sasl-username/versions/latest"
+        path: "kafka-sasl-username"
+      - resourceName: "projects/hospital-management-514618/secrets/kafka-analytics-sasl-password/versions/latest"
+        path: "kafka-sasl-password"
