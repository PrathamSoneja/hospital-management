+# Public, read-only, aggregate bed availability (counts per DEMO- pool; no identifiers). Proposal: replaces the
+# health-only Patient Registry Ingress once approved (one load balancer only).
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: hospital-public
+  annotations:
+    kubernetes.io/ingress.class: gce
+spec:
+  rules:
+    - http:
+        paths:
+          - path: /api/v1/public/availability
+            pathType: Exact
+            backend:
+              service:
+                name: bed-registry-service
+                port: {number: 8000}
