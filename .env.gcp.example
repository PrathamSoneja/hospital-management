# GCP runtime template (staging/production). Copy to the ignored .env.gcp only for
# reviewing values; on GKE these come from ConfigMaps (non-secret) and Secret Manager
# (secret) through the manifests in k8s/. Never put credentials in this file.
# Empty values are REQUIRED and must come from the source named in the comment
# (see docs/gcp-integration-runbook.md, "Variable sources").
# Authentication: Workload Identity on GKE, `gcloud auth application-default login`
# for local review only. Do not set GOOGLE_APPLICATION_CREDENTIALS or export tokens.

ENVIRONMENT=staging
LOG_LEVEL=INFO

# --- Project / region (Terraform: infra/terraform variables, owner Ruchir) ---
GCP_PROJECT_ID=
GCP_REGION=

# --- Bed Allocation (Cloud SQL PostgreSQL via Cloud SQL Auth Proxy sidecar) ---
# Full URL is a Secret Manager secret (allocation-database-url), injected as DATABASE_URL.
# Shape: postgresql+psycopg2://<runtime-user>@127.0.0.1:5432/<allocation-db>  (password in the secret)
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
ALLOCATION_REST_HOST=0.0.0.0
ALLOCATION_REST_PORT=8002
ENABLE_RECOVERY_WORKER=true
ENABLE_OUTBOX_WORKER=true
OUTBOX_CLAIM_SECONDS=30
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_MAX_BACKOFF_SECONDS=300
OUTBOX_POLL_SECONDS=1
OUTBOX_PUBLISH_TIMEOUT_SECONDS=10

# --- Teammate service endpoints (in-cluster DNS; values from each owner) ---
LOCK_SERVICE_ADDR=          # Nisarg: Lock Coordinator gRPC, e.g. <service>.<namespace>.svc.cluster.local:<port>
BED_SERVICE_ADDR=           # Jay: Bed Registry gRPC
STAFF_SERVICE_ADDR=         # Ruchir: Staff Scheduler gRPC
TRIAGE_SERVICE_ADDR=triage-service:50051
PATIENT_SERVICE_URL=        # Ruchir: Patient Registry REST base URL ending in /api/v1
RPC_TIMEOUT_MS=2000
LOCK_WAIT_TIMEOUT_MS=5000
LOCK_LEASE_MS=10000

# --- Triage (Firestore Native + Lock Coordinator) ---
TRIAGE_STORAGE_BACKEND=firestore
TRIAGE_FENCING_MODE=coordinator
FIRESTORE_PROJECT_ID=       # usually GCP_PROJECT_ID
LOCK_COORDINATOR_ADDR=      # same Coordinator as LOCK_SERVICE_ADDR
TRIAGE_REST_HOST=0.0.0.0
TRIAGE_REST_PORT=8001
TRIAGE_GRPC_HOST=0.0.0.0
TRIAGE_GRPC_PORT=50051
START_GRPC=true

# --- Pub/Sub (Terraform/Nisarg: topic feeding Eventarc -> Cloud Run function) ---
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC_NOTIFICATIONS=

# --- Kafka on GKE (Jay) ---
KAFKA_BOOTSTRAP_SERVERS=    # in-cluster bootstrap service:port
KAFKA_TOPIC_BED_EVENTS=
KAFKA_SECURITY_PROTOCOL=    # SASL_SSL or SSL as configured by the Kafka owner
KAFKA_SASL_MECHANISM=       # e.g. SCRAM-SHA-512, when SASL is used
KAFKA_SSL_CA_LOCATION=      # mounted CA bundle path, when TLS is used
# KAFKA_SASL_USERNAME / KAFKA_SASL_PASSWORD are injected from Secret Manager; never set here.
