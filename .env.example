# ==============================================================================
# Hospital Bed Management - Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS
# ==============================================================================

# Environment Mode: local, test, or production
ENVIRONMENT=local
LOG_LEVEL=INFO
USE_FAKES=true

# Triage Service Configuration
TRIAGE_REST_HOST=0.0.0.0
TRIAGE_REST_PORT=8001
TRIAGE_GRPC_HOST=0.0.0.0
TRIAGE_GRPC_PORT=50052
TRIAGE_STORAGE_BACKEND=memory # memory or firestore
FIRESTORE_PROJECT_ID=hospital-bed-mgmt-dev
FIRESTORE_EMULATOR_HOST=localhost:8080

# Bed Allocation Service Configuration
ALLOCATION_REST_HOST=0.0.0.0
ALLOCATION_REST_PORT=8002
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_allocation

# Patient Registry Service Configuration
PATIENT_REGISTRY_REST_HOST=0.0.0.0
PATIENT_REGISTRY_REST_PORT=8000
PATIENT_REGISTRY_DATABASE_URL=
PATIENT_DOCUMENTS_BUCKET=

# Downstream Service Addresses (Internal RPC / REST)
LOCK_SERVICE_ADDR=localhost:50051
BED_SERVICE_ADDR=localhost:50053
STAFF_SERVICE_ADDR=localhost:50054
PATIENT_SERVICE_URL=http://localhost:8000/api/v1
TRIAGE_SERVICE_ADDR=localhost:50052

# Deadlines and Timeouts (milliseconds)
RPC_TIMEOUT_MS=2000
LOCK_WAIT_TIMEOUT_MS=5000
LOCK_LEASE_MS=10000

# Event Messaging: Google Pub/Sub
GCP_PROJECT_ID=hospital-bed-mgmt-dev
PUBSUB_TOPIC_NOTIFICATIONS=bed-notifications
PUBSUB_EMULATOR_HOST=localhost:8085

# Event Messaging: Apache Kafka (GKE-hosted in cloud)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_BED_EVENTS=bed-events
KAFKA_TOPIC_BED_STATS=bed-stats
