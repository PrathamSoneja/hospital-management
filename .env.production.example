# Production runtime template. Inject secrets through the approved secret store.
# No emulator hosts, in-memory fallbacks, or fake publishers are supported here.
ENVIRONMENT=production
LOG_LEVEL=INFO

# Bed Allocation: Cloud SQL PostgreSQL URL (psycopg2 driver).
# Format: postgresql+psycopg2://USER:PASSWORD@CLOUD_SQL_PRIVATE_IP:5432/allocations?sslmode=require
DATABASE_URL=
ALLOCATION_REST_HOST=0.0.0.0
ALLOCATION_REST_PORT=8002
ENABLE_RECOVERY_WORKER=true

# Triage: Firestore Native and the real Lock Coordinator.
TRIAGE_STORAGE_BACKEND=firestore
TRIAGE_FENCING_MODE=coordinator
FIRESTORE_PROJECT_ID=
LOCK_COORDINATOR_ADDR=lock-coordinator-service:50051
TRIAGE_REST_HOST=0.0.0.0
TRIAGE_REST_PORT=8001
TRIAGE_GRPC_HOST=0.0.0.0
TRIAGE_GRPC_PORT=50052

# Real teammate service endpoints; do not use stubs or localhost in GKE.
LOCK_SERVICE_ADDR=lock-coordinator-service:50051
BED_SERVICE_ADDR=bed-registry-service:50051
STAFF_SERVICE_ADDR=staff-scheduler-service:50051
TRIAGE_SERVICE_ADDR=triage-service:50051
PATIENT_SERVICE_URL=http://patient-registry-service:8000/api/v1

# Patient Registry Cloud SQL and private Cloud Storage.
PATIENT_REGISTRY_DATABASE_URL=
PATIENT_DOCUMENTS_BUCKET=
GCP_PROJECT_ID=

# Cloud messaging. Runtime credentials are injected from the secret manager.
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC_NOTIFICATIONS=bed-notifications
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_TOPIC_BED_EVENTS=bed-events
KAFKA_TOPIC_BED_STATS=bed-stats
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

RPC_TIMEOUT_MS=2000
LOCK_WAIT_TIMEOUT_MS=5000
LOCK_LEASE_MS=10000
